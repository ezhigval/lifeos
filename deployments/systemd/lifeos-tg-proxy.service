[Unit]
Description=LifeOS Telegram egress proxy (local forwarder to Cloudflare Worker)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/lifeos/bin/tg-proxy-run.sh
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
