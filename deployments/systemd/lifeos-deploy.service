[Unit]
Description=LifeOS pull-deploy (fetch main, rebuild only on new commit)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/lifeos/repo
# Installed to /opt/lifeos/bin by autodeploy.sh. The script caps the image
# build and keeps sshd/nginx off the OOM killer's short list.
ExecStart=/opt/lifeos/bin/vm-pull-deploy.sh
TimeoutStartSec=1200
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMScoreAdjust=500
