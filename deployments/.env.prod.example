# Copy to deployments/.env.prod and fill in.
# NEVER commit the filled file.

# --- Domain / TLS ---
LIFEOS_DOMAIN=lifeos.example.com
CADDY_ACME_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lifeos

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
LIFEOS_TELEGRAM_MODE=webhook
LIFEOS_TELEGRAM_WEBHOOK_SECRET=change-me-long-random
# Optional: chat id to receive a fresh Mini App button after deploy
LIFEOS_SEED_TELEGRAM_ID=1034074077

# --- Auth ---
LIFEOS_JWT_SECRET=change-me-long-random
LIFEOS_API_KEY=change-me-local-api-key
LIFEOS_JWT_TTL_HOURS=168
LIFEOS_WEBAPP_AUTH_TTL_HOURS=24

# --- App ---
LIFEOS_LOG_LEVEL=info
LIFEOS_LOG_FORMAT=text
LIFEOS_SEED_TIMEZONE=Europe/Moscow
LIFEOS_LLM_ENABLED=false
