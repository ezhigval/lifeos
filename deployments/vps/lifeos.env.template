# LifeOS VPS environment — заполняется install.sh из значений dev-стенда.
# Database (локальный PostgreSQL на ВМ, порт 5432)
LIFEOS_DATABASE_URL=postgres://lifeos:${PG_PASSWORD}@localhost:5432/lifeos?sslmode=disable

# HTTP (nginx/cloudflared проксируют наружу, сам сервис слушает loopback)
LIFEOS_HTTP_ADDR=127.0.0.1:8080

# Logging
LIFEOS_LOG_LEVEL=info
LIFEOS_LOG_FORMAT=text

# Telegram
TELEGRAM_BOT_TOKEN=${TG_BOT_TOKEN}
LIFEOS_TELEGRAM_MODE=polling

# Default timezone for new Telegram users
LIFEOS_SEED_TIMEZONE=Europe/Moscow
LIFEOS_SEED_TELEGRAM_ID=0
LIFEOS_SEED_DISPLAY_NAME=Valentin

# REST API / Mini App auth
LIFEOS_JWT_SECRET=${JWT_SECRET}
LIFEOS_API_KEY=${API_KEY}
LIFEOS_JWT_TTL_HOURS=168
LIFEOS_WEBAPP_AUTH_TTL_HOURS=24

# Telegram Mini App (заполняется после получения туннельного URL)
LIFEOS_MINIAPP_URL=PASTE-TUNNEL-HOST/app/
LIFEOS_STATIC_DIR=/opt/lifeos/src/web/miniapp/dist

# LLM / STT / Vision — off on first deploy
LIFEOS_LLM_ENABLED=false
LIFEOS_LLM_AGENT_ENABLED=false
LIFEOS_STT_ENABLED=false
LIFEOS_VISION_ENABLED=false

# OpenTelemetry (optional)
LIFEOS_OTEL_ENABLED=false

# HMAC salt for anonymous learning subjects
LIFEOS_LEARNING_SALT=${LEARNING_SALT}

# Telegram egress proxy (Yandex Cloud blocks api.telegram.org directly).
# Set by tg-proxy.sh install; leave empty on hosts with direct Telegram access.
LIFEOS_HTTP_PROXY=
LIFEOS_TG_PROXY_WORKER_URL=
