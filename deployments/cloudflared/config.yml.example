# Locally-managed ingress. The VM unit uses TUNNEL_TOKEN, so the live
# ingress is the public hostname in Zero Trust, not this file.
# Service is the Go app. Do not point it at nginx (:80).
# Rollback while nginx is running: service http://127.0.0.1:80.
# See docs/deploy/EDGE.md.
tunnel: lifeos
ingress:
  - hostname: lifeos.example.com
    service: http://127.0.0.1:8080
  - service: http_status:404
