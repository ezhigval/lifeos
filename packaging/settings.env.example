# LifeOS — desktop / local package settings
# Copy to settings.env (or use Start — it creates one) and edit.

# --- Required ---
# Postgres connection string
LIFEOS_DATABASE_URL=postgres://lifeos:lifeos@127.0.0.1:5432/lifeos?sslmode=disable

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# JWT for Mini App / REST (long random string)
LIFEOS_JWT_SECRET=change-me-generate-a-long-random-string
LIFEOS_API_KEY=change-me-local-api-key

# --- Server ---
LIFEOS_HTTP_ADDR=:8080
LIFEOS_LOG_LEVEL=info
LIFEOS_LOG_FORMAT=text

# polling = no public URL needed; webhook = needs HTTPS
LIFEOS_TELEGRAM_MODE=polling

# Mini App public HTTPS URL ending with /app/
# Leave empty for bot-only / local curling of REST.
# With cloudflared: https://xxxx.trycloudflare.com/app/
LIFEOS_MINIAPP_URL=

# Webhook (only if LIFEOS_TELEGRAM_MODE=webhook)
# LIFEOS_TELEGRAM_WEBHOOK_URL=https://xxxx.trycloudflare.com/webhook/telegram
# LIFEOS_TELEGRAM_WEBHOOK_SECRET=change-me

# Seed / timezone
LIFEOS_SEED_TIMEZONE=Europe/Moscow
LIFEOS_SEED_TELEGRAM_ID=0
LIFEOS_SEED_DISPLAY_NAME=Valentin

LIFEOS_JWT_TTL_HOURS=168
LIFEOS_WEBAPP_AUTH_TTL_HOURS=24

# LLM off by default
LIFEOS_LLM_ENABLED=false
