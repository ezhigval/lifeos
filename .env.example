# Database
LIFEOS_DATABASE_URL=postgres://lifeos:lifeos@localhost:5433/lifeos?sslmode=disable

# HTTP
LIFEOS_HTTP_ADDR=:8080

# Logging
LIFEOS_LOG_LEVEL=info
LIFEOS_LOG_FORMAT=text

# Telegram
TELEGRAM_BOT_TOKEN=
LIFEOS_TELEGRAM_MODE=polling
# Webhook mode (requires public HTTPS URL):
# LIFEOS_TELEGRAM_MODE=webhook
# LIFEOS_TELEGRAM_WEBHOOK_URL=https://your-host/webhook/telegram
# LIFEOS_TELEGRAM_WEBHOOK_SECRET=change-me

# Default timezone for new Telegram users
LIFEOS_SEED_TIMEZONE=Europe/Moscow

# Seed user for CLI commands (optional)
LIFEOS_SEED_TELEGRAM_ID=0
LIFEOS_SEED_DISPLAY_NAME=Valentin

# REST API / Mini App auth
LIFEOS_JWT_SECRET=change-me-in-production
LIFEOS_API_KEY=
# Mini App keeps JWT in localStorage; longer TTL = fewer initData roundtrips
LIFEOS_JWT_TTL_HOURS=168
# How long Telegram initData (auth_date) is accepted — keep shorter than JWT
LIFEOS_WEBAPP_AUTH_TTL_HOURS=24

# Telegram Mini App (must be public HTTPS ending with /app/)
# Example with cloudflared: https://xxxx.trycloudflare.com/app/
LIFEOS_MINIAPP_URL=
# Built frontend assets (docker image defaults to /app/web)
LIFEOS_STATIC_DIR=web/miniapp/dist

# Optional LLM. When false: rule-based intents + template review summaries only.
# When true: rule-based first; LLM only for unknown intents / review prose.
# Provider down or slow (≈8s) → logged degrade to rule-based / template.
# See docs/ops/LLM.md for free cloud providers (Groq, Gemini, OpenRouter).
LIFEOS_LLM_ENABLED=false
LIFEOS_LLM_AGENT_ENABLED=true
LIFEOS_LLM_PROVIDER=openai
LIFEOS_LLM_API_KEY=
# Alias also accepted: LIFEOS_OPENAI_API_KEY
LIFEOS_LLM_BASE_URL=https://api.groq.com/openai/v1
LIFEOS_LLM_MODEL=llama-3.3-70b-versatile
# Ollama alternative:
# LIFEOS_LLM_PROVIDER=ollama
# LIFEOS_OLLAMA_URL=http://localhost:11434
# LIFEOS_OLLAMA_MODEL=llama3.2
LIFEOS_OLLAMA_URL=http://localhost:11434
LIFEOS_OLLAMA_MODEL=llama3.2
# Dev-only: allow scripts/mock_ollama.go (advertises lifeos_mock in /api/tags)
# LIFEOS_ALLOW_MOCK_LLM=true
# Dev-only: start without bot / without REST API
# LIFEOS_ALLOW_NO_TELEGRAM=true
# LIFEOS_ALLOW_NO_API=true

# OpenTelemetry (optional)
LIFEOS_OTEL_ENABLED=false
LIFEOS_OTEL_ENDPOINT=localhost:4318

# HMAC salt for anonymous learning subjects (change in prod)
LIFEOS_LEARNING_SALT=lifeos-dev-learning-salt-change-me
